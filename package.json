{
  "name": "slime-rush",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node tests/e2e/run.mjs",
    "test:e2e:mobile": "vite build && node tests/e2e/run.mjs --only=orientation",
    "test:e2e:texts": "vite build && node tests/e2e/run.mjs --only=texts",
    "test:e2e:platforms": "vite build && node tests/e2e/run.mjs --only=platforms",
    "test:all": "tsc --noEmit && vitest run && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
